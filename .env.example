# Environment variables for Docker Compose and Deployment
# Copy this file to .env and update with your actual values
# These values are based on the default configuration from application.properties

# ============================================
# DATABASE CONFIGURATION (Development/Docker)
# ============================================
# MySQL Database for local development
MYSQL_ROOT_PASSWORD=new_password
MYSQL_DATABASE=tms_db
MYSQL_USER=root
MYSQL_PASSWORD=new_password

# ============================================
# DATABASE CONFIGURATION (Production)
# ============================================
# PostgreSQL for production deployment (Render, Railway, etc.)
# Neon PostgreSQL Database (Free Tier: 10GB storage, 3 branches)
# 
# ⚠️ IMPORTANT: Use DIRECT connection (without -pooler) for Hibernate DDL operations!
# Direct connection supports table creation, pooled does not.
DATABASE_URL=jdbc:postgresql://ep-winter-rain-ah5z20py.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=npg_vqNdXjba06Ot

# ============================================
# SERVER CONFIGURATION
# ============================================
# Server port (default: 8083)
SERVER_PORT=8083
# For Render/Railway, use PORT instead (they auto-assign)
PORT=8083

# ============================================
# JWT AUTHENTICATION CONFIGURATION
# ============================================
# JWT Secret Key (CHANGE THIS IN PRODUCTION!)
# Generate a secure key using: openssl rand -base64 64
JWT_SECRET=yourVeryStrongAndSecureSecretKeyForJWTAuthenticationWhichShouldBeLongerThan256Bits
# JWT Token Expiration Time in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# ============================================
# EMAIL CONFIGURATION
# ============================================
# Email server for sending notifications
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Gmail credentials (default from application.properties)
MAIL_USERNAME=saranprakash3112@gmail.com
MAIL_PASSWORD=xossgfyrsltmzzgf

# For production, use your own Gmail App Password:
# 1. Go to Google Account Settings
# 2. Enable 2-Factor Authentication
# 3. Generate an App Password for "Mail"
# 4. Replace MAIL_USERNAME and MAIL_PASSWORD above

# ============================================
# CORS CONFIGURATION
# ============================================
# Allowed origins for Cross-Origin Resource Sharing
# For development: http://localhost:4200
# For production: Add your deployed frontend URL (Netlify, Vercel, etc.)
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://69110b71f7e815e09a39d640--dashing-gecko-aa9aa4.netlify.app

# Production-only (use this in Render):
# CORS_ALLOWED_ORIGINS=https://69110b71f7e815e09a39d640--dashing-gecko-aa9aa4.netlify.app

# Multiple origins example (comma-separated):
# CORS_ALLOWED_ORIGINS=http://localhost:4200,https://your-app.netlify.app,https://your-domain.com

# ============================================
# FRONTEND CONFIGURATION
# ============================================
# Backend API URL for frontend environment.ts
# Development:
API_BASE_URL=http://localhost:8083/api
# Production (Render):
# API_BASE_URL=https://training-management-system-dyy0.onrender.com/api

# ============================================
# DEPLOYMENT CHECKLIST (Render/Railway)
# ============================================
# Make sure ALL of these are set in your hosting platform:
# ✅ DATABASE_URL
# ✅ DB_USERNAME
# ✅ DB_PASSWORD
# ✅ JWT_SECRET (CRITICAL - App won't start without this!)
# ✅ JWT_EXPIRATION_MS
# ✅ MAIL_HOST
# ✅ MAIL_PORT
# ✅ MAIL_USERNAME
# ✅ MAIL_PASSWORD
# ✅ CORS_ALLOWED_ORIGINS
#
# See RENDER-ENV-VARIABLES.md for step-by-step setup guide
